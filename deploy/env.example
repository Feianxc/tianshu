# /etc/wanglou/env，权限 0640，属主 root:wanglou
WANGLOU_ADDR=127.0.0.1:8787
WANGLOU_DATA=/var/lib/wanglou
# 探测从哪里发出。结果要和位置一起看才有意义。
WANGLOU_VANTAGE=server
# 公网地址。设置后才启用 OAuth，dots 和 ChatGPT 需要它。
WANGLOU_PUBLIC_URL=https://tianshu.example.com
# 经 Cloudflare Tunnel 部署时开启，否则所有客户端都显示为 127.0.0.1
WANGLOU_TRUST_CF=1
# 新发现的仓库默认放进这个空间，之后在界面里改
WANGLOU_GITHUB_WORKSPACE=personal
# 服务器上没有 gh，需要一个只读令牌。优先用只授权到具体仓库的细粒度令牌。
# 这是秘密，只放在这个文件里，不进目录、不进日志。
# WANGLOU_GITHUB_TOKEN=
# 完全不接 GitHub 时：
# WANGLOU_GITHUB=off
